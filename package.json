{
  "name": "@simonprinz/netbox-mcp",
  "version": "1.1.0",
  "description": "Model Context Protocol (MCP) server exposing the NetBox REST API over Streamable HTTP.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SimonPrinz/netbox-mcp.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "bin": {
    "netbox-mcp": "./build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs && node -e \"require('fs').chmodSync('build/index.js', '755')\"",
    "prepare": "npm run build",
    "start": "node build/index.js",
    "watch": "tsc --watch",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:mock": "vitest run test/mock",
    "inspector": "npx @modelcontextprotocol/inspector --transport http --server-url http://127.0.0.1:3000/mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "undici": "^8.12.3",
    "yaml": "^2.9.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.3.3",
    "vitest": "^5.0.5"
  }
}